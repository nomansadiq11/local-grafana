      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "eegt2oll384jkd"
          },
          "queryText": "WITH monthly AS (\n  SELECT\n    date(expensed_date, 'start of month') AS month_start,\n    SUM(CASE WHEN lower(category) = 'income' THEN CAST(REPLACE(amount, ',', '') AS REAL) ELSE 0 END) AS income,\n    SUM(CASE WHEN lower(category) != 'income' THEN CAST(REPLACE(amount, ',', '') AS REAL) ELSE 0 END) AS expense\n  FROM expense_report\n  WHERE \n  account = '$account' \n    AND expensed_date BETWEEN '$from' AND '$to'\n  GROUP BY 1\n),\nrunning AS (\n  SELECT\n    month_start,\n    income,\n    expense,\n    income - expense AS net,\n    SUM(income - expense) OVER (ORDER BY month_start) AS balance\n  FROM monthly\n)\nSELECT\n  strftime('%Y-%m-01T00:00:00Z', month_start) AS time,\n  income,\n  expense,\n  net,\n  balance\nFROM running\nORDER BY time;",
          "queryType": "time series",
          "rawQueryText": "WITH monthly AS (\n  SELECT\n    date(expensed_date, 'start of month') AS month_start,\n    SUM(CASE WHEN lower(category) = 'income' THEN CAST(REPLACE(amount, ',', '') AS REAL) ELSE 0 END) AS income,\n    SUM(CASE WHEN lower(category) != 'income' THEN CAST(REPLACE(amount, ',', '') AS REAL) ELSE 0 END) AS expense\n  FROM expense_report\n  WHERE \n  account = '$account' \n    AND expensed_date BETWEEN '$from' AND '$to'\n  GROUP BY 1\n),\nrunning AS (\n  SELECT\n    month_start,\n    income,\n    expense,\n    income - expense AS net,\n    SUM(income - expense) OVER (ORDER BY month_start) AS balance\n  FROM monthly\n)\nSELECT\n  strftime('%Y-%m-01T00:00:00Z', month_start) AS time,\n  income,\n  expense,\n  net,\n  balance\nFROM running\nORDER BY time;",
          "refId": "A",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
      ],
      "title": "Monthly Cumulative savings",
      "type": "barchart"
    },
